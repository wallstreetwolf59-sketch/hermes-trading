# Copy to .env for local runs. NEVER commit .env - it is gitignored.
# On GitHub Actions these come from repo Secrets, not from a file.

HERMES_TRADING_MODE=paper
HERMES_TRADING_I_ACCEPT_RISK=false

# Optional. Every adapter falls back to a free public endpoint without these.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
GLASSNODE_API_KEY=
NEWS_API_KEY=
